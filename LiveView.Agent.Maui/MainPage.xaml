<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:camera="clr-namespace:Camera.MAUI;assembly=Camera.MAUI"
            x:Class="LiveView.Agent.Maui.MainPage">

    <ScrollView>
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto, Auto">

            <Entry x:Name="serverEntry" Text="192.168.0.1:4444" Placeholder="Enter server address" />
            <Entry Grid.Row="1" Text="{Binding BufferSize, Mode=TwoWay}" Keyboard="Numeric" Completed="OnNumberCompleted" Placeholder="Buffer size" />
            <Entry Grid.Row="2" x:Name="preferredIpAddressEntry" Text="192.168.0." Placeholder="Preferred IP address for traffic (outgoing interface IP)" />

            <Grid Grid.Row="3" ColumnDefinitions="*, Auto">
                <Entry x:Name="cameraNameEntry" Text="Camera" Placeholder="Camera name" Grid.Column="0" />
                <Picker Title="Select Camera" ItemsSource="{Binding AvailableCameras}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedCamera, Mode=TwoWay}" Grid.Column="1" />
            </Grid>

            <camera:CameraView Grid.Row="4" x:Name="cameraView" WidthRequest="300" HeightRequest="400" />
            <Button Grid.Row="5" x:Name="startStopButton" Text="Start" Clicked="StartCamera_Clicked" />
            <Label Grid.Row="6" x:Name="serverLabel" Text="Server: Not started" FontSize="14" TextColor="Black"/>

        </Grid>
    </ScrollView>

</ContentPage>
