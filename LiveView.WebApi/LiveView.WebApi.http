@LiveView_WebApi_HostAddress = https://localhost:44326
# @resources = [actionobjects, agents, barcodecharchangers, barcodescanoptions, barcodescanreadings, camerafunctions,
#   camerapermissions, cameras, databaseservers, displays, gridcameras, grids, groupmembers, groups, inputoutputports,
#   inputoutputportrules, inputoutputportslog, logentries, mapactionobjects, maps, migrations, operations, permissions,
#   sequencegrids, sequences, templateprocesses, templates, userevents, users, videoservers, videosources]

#@resource = cameras
@resource = {{$prompt "Choose a resource:" "actionobjects,agents,barcodecharchangers,barcodescanoptions,barcodescanreadings,camerafunctions,camerapermissions,cameras,databaseservers,displays,gridcameras,grids,groupmembers,groups,inputoutputports,inputoutputportrules,inputoutputportslog,logentries,mapactionobjects,maps,migrations,operations,permissions,sequencegrids,sequences,templateprocesses,templates,userevents,users,videoservers,videosources"}}
@id = 1

### GET all
GET {{LiveView_WebApi_HostAddress}}/api/{{resource}}/
Accept: application/json

### GET by id
GET {{LiveView_WebApi_HostAddress}}/api/{{resource}}/{{id}}
Accept: application/json

### CREATE
POST {{LiveView_WebApi_HostAddress}}/api/{{resource}}/
Content-Type: application/json

{
  "name": "New item",
  "description": "Test item"
}

### UPDATE
PUT {{LiveView_WebApi_HostAddress}}/api/{{resource}}/{{id}}
Content-Type: application/json

{
  "id": {{id}},
  "name": "Updated item",
  "description": "Updated test item"
}

### DELETE
DELETE {{LiveView_WebApi_HostAddress}}/api/{{resource}}/{{id}}